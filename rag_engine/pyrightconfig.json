{
  "pythonVersion": "3.13",
  "pythonPlatform": "Windows",
  "venvPath": ".",
  "venv": ".venv",
  "typeCheckingMode": "basic",
  "reportMissingImports": true,
  "reportMissingModuleSource": false,
  "reportUnusedImport": false,
  "extraPaths": [
    ".",
    "./api"
  ],
  "exclude": [
    ".venv",
    "**/__pycache__"
  ]
}
