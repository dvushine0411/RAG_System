# ─────────────────────────────────────────────────────────────────
# .env.example — Enterprise RAG System
# Copy file này thành .env và điền giá trị thật trước khi chạy
# KHÔNG commit file .env vào git
# ─────────────────────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────────────────────
MONGO_USER=rag_user
MONGO_PASSWORD=rag_secret
MONGO_DB=rag_db

# ── Qdrant ───────────────────────────────────────────────────────
# (Không cần auth mặc định — thêm API key nếu dùng Qdrant Cloud)
QDRANT_API_KEY=

# ── Node.js API Service ───────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MAX_UPLOAD_BYTES=52428800

# ── Authentication (JWT + bcrypt) ────────────────────────────────
# Sinh secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-at-least-32-characters-access
JWT_REFRESH_SECRET=change-me-at-least-32-characters-refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
REFRESH_REUSE_GRACE_SECONDS=10
# COOKIE_SECURE=true khi chạy HTTPS
COOKIE_SECURE=false
BCRYPT_COST=11
# Tài khoản admin được tạo tự động khi API khởi động (nếu chưa có)
ADMIN_EMAIL=admin@rag.local
ADMIN_PASSWORD=change-me-Admin123

# ── Python RAG Engine ────────────────────────────────────────────
RAG_ENGINE_PORT=8000

# ── LLM & Embedding Providers ────────────────────────────────────
OPENAI_API_KEY=sk-...
COHERE_API_KEY=...

# OpenAI Embedding Model (ARCHITECTURE.md §2.2 Phase A)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# LLM Model (chọn 1 trong các provider bên dưới)
LLM_PROVIDER=openai   # openai | gemini | anthropic
LLM_MODEL=gpt-4o

# Gemini (nếu dùng)
GOOGLE_API_KEY=

# Anthropic (nếu dùng)
ANTHROPIC_API_KEY=

# ── Reranker (ARCHITECTURE.md §4, Phase 4) ───────────────────────
RERANKER_PROVIDER=cohere   # cohere | onnx_local
RERANKER_MODEL=rerank-multilingual-v3.0
RERANK_TOP_N=3

# ── HNSW Search Parameters (ARCHITECTURE.md §3.1) ────────────────
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=40
RETRIEVAL_TOP_K=50

# ── RAG quality / latency (Phase 8 evaluation — rag_engine/reports/) ──
DEFAULT_CHUNK_SIZE=256
DEFAULT_CHUNK_OVERLAP=32
RERANK_MIN_SCORE=0
QUERY_REWRITE_ENABLED=true
SYSTEM_PROMPT_VERSION=v2
QDRANT_PREFER_GRPC=true
PDF_OCR_ENABLED=true
PDF_OCR_MODEL=gpt-4o-mini

# ── Frontend (build-time, xem frontend/.env.example) ──────────────
# Để trống = gọi cùng origin qua Nginx proxy /api
VITE_API_BASE_URL=
