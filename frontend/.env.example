# frontend/.env.example — copy to frontend/.env for local `npm run dev`
# Base URL prefixed to every /api/v1/* call. Empty = same origin (Nginx proxy in Docker, Vite proxy in dev).
VITE_API_BASE_URL=
# Where the Vite dev server proxies /api requests (local development only).
VITE_DEV_PROXY_TARGET=http://localhost:3000
